// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TypeLogement {
  locataire
  proprietaire
  heberge
}

enum StatutInvitation {
  pending
  viewed
  completed
}

model Account {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dossier Dossier?
}

model Dossier {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id])

  personnes Personne[]
}

model Personne {
  id           String       @id @default(uuid())
  nom          String
  prenom       String
  email        String?
  telephone    String?
  revenus      Int?
  typeLogement TypeLogement
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  statutId  String
  statut    Statut    @relation(fields: [statutId], references: [id])
  dossierId String
  dossier   Dossier   @relation(fields: [dossierId], references: [id])

  documents Document[]
}

model Document {
  id        String   @id @default(uuid())
  nom       String
  nomFichier String
  chemin     String
  mimeType   String
  taille     Int
  typeDocumentId           String
  typeDocument             DocumentType @relation(fields: [typeDocumentId], references: [id])
  typeDocumentPersonnalise String?
  personneId String
  personne   Personne @relation(fields: [personneId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Statut {
  id        String   @id @default(uuid())
  nom       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personnes               Personne[]
  statutDocumentTypes StatutDocumentType[]
}

model DocumentType {
  id        String   @id @default(uuid())
  nom       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statutDocumentTypes StatutDocumentType[]
  documents           Document[]
}

model StatutDocumentType {
  statutId       String
  documentTypeId String
  statut         Statut       @relation(fields: [statutId], references: [id])
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  @@id([statutId, documentTypeId])
}
