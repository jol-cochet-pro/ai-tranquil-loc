// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TypeLogement {
  locataire
  proprietaire
  heberge
}

enum StatutInvitation {
  pending
  viewed
  completed
}

enum Role {
  candidat
  co_candidat
  garant
}

model Account {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dossier Dossier?
}

model Dossier {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id])

  personnes    Personne[]
  transmissions Transmission[]
}

model Personne {
  id           String       @id @default(uuid())
  nom          String
  prenom       String
  email        String?
  telephone    String?
  revenus      Int?
  role         Role           @default(candidat)
  typeLogement TypeLogement
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  statutId  String
  statut    Statut    @relation(fields: [statutId], references: [id])
  dossierId String
  dossier   Dossier   @relation(fields: [dossierId], references: [id])

  documents   Document[]
  invitations Invitation[]
}

model Invitation {
  id         String          @id @default(uuid())
  token      String          @unique
  statut     StatutInvitation @default(pending)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  personneId String
  personne   Personne @relation(fields: [personneId], references: [id])
}

model Document {
  id        String   @id @default(uuid())
  nom       String
  nomFichier String
  chemin     String
  mimeType   String
  taille     Int
  typeDocumentId           String
  typeDocument             DocumentType @relation(fields: [typeDocumentId], references: [id])
  typeDocumentPersonnalise String?
  personneId String
  personne   Personne @relation(fields: [personneId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Statut {
  id        String   @id @default(uuid())
  nom       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personnes               Personne[]
  statutDocumentTypes StatutDocumentType[]
}

model DocumentType {
  id        String   @id @default(uuid())
  nom       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statutDocumentTypes StatutDocumentType[]
  documents           Document[]
  transmissionDocumentTypes TransmissionDocumentType[]
}

model StatutDocumentType {
  statutId       String
  documentTypeId String
  statut         Statut       @relation(fields: [statutId], references: [id])
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  @@id([statutId, documentTypeId])
}

model Transmission {
  id        String    @id @default(uuid())
  token     String    @unique
  expireAt  DateTime?
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id])

  transmissionDocumentTypes TransmissionDocumentType[]
}

model TransmissionDocumentType {
  transmissionId String
  documentTypeId String

  transmission  Transmission  @relation(fields: [transmissionId], references: [id], onDelete: Cascade)
  documentType  DocumentType  @relation(fields: [documentTypeId], references: [id])

  @@id([transmissionId, documentTypeId])
}
